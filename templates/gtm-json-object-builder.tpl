      builderFields: [
        {builderKey: 'n1', builderValue: '42', builderType: 'number'},
        {builderKey: 'n2', builderValue: 3.5, builderType: 'number'}
      ]
    });
    assertThat(result).isEqualTo({n1: 42, n2: 3.5});
- name: Invalid number is omitted
  code: |
    const logs = [];
    mock('logToConsole', function(msg) { logs.push(msg); });
    const result = runCode({
      builderFields: [
        {builderKey: 'keep', builderValue: 'ok', builderType: 'string'},
        {builderKey: 'bad', builderValue: 'abc', builderType: 'number'}
      ]
    });
    assertThat(result).isEqualTo({keep: 'ok'});
    assertThat(logs.length).isGreaterThan(0);
    assertThat(logs[0].indexOf('invalid_number')).isGreaterThan(-1);
    assertThat(logs[0].indexOf('abc')).isEqualTo(-1);
- name: Valid boolean variants are converted
  code: |
    const result = runCode({
      builderFields: [
        {builderKey: 'a', builderValue: true, builderType: 'boolean'},
        {builderKey: 'b', builderValue: false, builderType: 'boolean'},
        {builderKey: 'c', builderValue: 1, builderType: 'boolean'},
        {builderKey: 'd', builderValue: 0, builderType: 'boolean'},
        {builderKey: 'e', builderValue: 'true', builderType: 'boolean'},
        {builderKey: 'f', builderValue: 'false', builderType: 'boolean'},
        {builderKey: 'g', builderValue: '1', builderType: 'boolean'},
        {builderKey: 'h', builderValue: '0', builderType: 'boolean'}
      ]
    });
    assertThat(result).isEqualTo({
      a: true, b: false, c: true, d: false,
      e: true, f: false, g: true, h: false
    });
- name: Yes and no are rejected as booleans
  code: |
    const logs = [];
    mock('logToConsole', function(msg) { logs.push(msg); });
    const result = runCode({
      builderFields: [
        {builderKey: 'keep', builderValue: 'ok', builderType: 'string'},
        {builderKey: 'flag_a', builderValue: 'yes', builderType: 'boolean'},
        {builderKey: 'flag_b', builderValue: 'no', builderType: 'boolean'}
      ]
    });
    assertThat(result).isEqualTo({keep: 'ok'});
    assertThat(logs.length).isGreaterThan(0);
    assertThat(logs[0].indexOf('invalid_boolean')).isGreaterThan(-1);
    assertThat(logs[0].indexOf('flag_a')).isGreaterThan(-1);
    assertThat(logs[0].indexOf('type=boolean')).isGreaterThan(-1);
    // Raw rejected values must never appear in logs.
    assertThat(logs[0].indexOf('yes')).isEqualTo(-1);
    assertThat(logs.join('|').indexOf('no')).isEqualTo(-1);
