    assertThat(getType(withoutMode)).isEqualTo('object');
    assertThat(withoutMode).isEqualTo({x: '1'});
    assertThat(withNative).isEqualTo({x: '1'});
    assertThat(getType(withJson)).isEqualTo('string');
    assertThat(withJson).isEqualTo('{"x":"1"}');
- name: Debug and error logs contain no raw values
  code: |
    const logs = [];
    mock('logToConsole', function(msg) { logs.push('' + msg); });
    const secret = 'secret-email@example.com';
    const result = runCode({
      builderFields: [
        {builderKey: 'email', builderValue: secret, builderType: 'string'},
        {builderKey: 'bad', builderValue: secret, builderType: 'number'}
      ],
      builderGroups: [
        {builderGroupName: 'user', builderGroupKey: 'id', builderGroupValue: 'u1', builderGroupType: 'string'}
      ],
      debugLogging: true,
      builderOutputMode: 'native_object'
    });
    assertThat(result.email).isEqualTo(secret);
    assertThat(logs.length).isGreaterThan(0);
    for (let i = 0; i < logs.length; i++) {
      assertThat(logs[i].indexOf(secret)).isEqualTo(-1);
      assertThat(logs[i].indexOf('@example.com')).isEqualTo(-1);
    }
    const joined = logs.join('|');
    assertThat(joined.indexOf('invalid mapped value')).isGreaterThan(-1);
    assertThat(joined.indexOf('debug summary')).isGreaterThan(-1);
    assertThat(joined.indexOf('top_level_keys')).isGreaterThan(-1);
- name: Grouped object overrides same named flat key
  code: |
    const getType = require('getType');
    const result = runCode({
      builderFields: [
        {builderKey: 'user', builderValue: 'flat-string', builderType: 'string'}
      ],
      builderGroups: [
        {builderGroupName: 'user', builderGroupKey: 'id', builderGroupValue: '123', builderGroupType: 'string'}
      ]
    });
    assertThat(getType(result.user)).isEqualTo('object');
    assertThat(result.user.id).isEqualTo('123');


