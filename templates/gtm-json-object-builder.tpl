___TESTS___

scenarios:
- name: Empty strings are omitted
  code: |
    const getType = require('getType');
    const result = runCode({
      builderFields: [
        {builderKey: 'keep', builderValue: 'ok', builderType: 'string'},
        {builderKey: 'empty', builderValue: '', builderType: 'string'}
      ],
      builderIgnoreEmpty: true
    });
    assertThat(result).isEqualTo({keep: 'ok'});
    assertThat(getType(result)).isEqualTo('object');
- name: Whitespace only values are omitted
  code: |
    const result = runCode({
      builderFields: [
        {builderKey: 'keep', builderValue: 'ok', builderType: 'string'},
        {builderKey: 'spaces', builderValue: '   ', builderType: 'string'},
        {builderKey: 'tabs', builderValue: '\t\n', builderType: 'string'}
      ]
    });
    assertThat(result).isEqualTo({keep: 'ok'});
- name: Undefined and null values are omitted
  code: |
    const result = runCode({
      builderFields: [
        {builderKey: 'keep', builderValue: 'ok', builderType: 'string'},
        {builderKey: 'undef', builderValue: undefined, builderType: 'string'},
        {builderKey: 'nul', builderValue: null, builderType: 'string'}
      ]
    });
    assertThat(result).isEqualTo({keep: 'ok'});
- name: Zero remains a number
  code: |
    const result = runCode({
      builderFields: [
        {builderKey: 'count', builderValue: 0, builderType: 'number'}
      ]
    });
    assertThat(result).isEqualTo({count: 0});
    assertThat(result.count).isEqualTo(0);
- name: False remains a boolean
  code: |
    const result = runCode({
      builderFields: [
        {builderKey: 'flag', builderValue: false, builderType: 'boolean'}
      ]
    });
    assertThat(result).isEqualTo({flag: false});
    assertThat(result.flag).isFalse();
- name: String zero remains a string
  code: |
    const result = runCode({
      builderFields: [
        {builderKey: 'code', builderValue: '0', builderType: 'string'}
      ]
